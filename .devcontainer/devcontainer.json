{
  "name": "AI Career Planner",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "updateContentCommand": "pip install --user -r requirements.txt",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "portsAttributes": {
    "8501": { "label": "My AI app", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
